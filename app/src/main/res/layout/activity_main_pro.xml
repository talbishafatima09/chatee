<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B141A">
 <LinearLayout android:background="#202C33" android:padding="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="60dp">
  <TextView android:text="●" android:textColor="#00A884" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:text="BlueChat PRO" android:textColor="#E9EDEF" android:textSize="19sp" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/btnCall" android:text="📞" android:contentDescription="Start or end voice call" android:textSize="20sp" android:background="@drawable/bg_send_circle" android:gravity="center" android:layout_width="44dp" android:layout_height="44dp"/>
 </LinearLayout>
 <LinearLayout android:background="@drawable/bg_top_container" android:orientation="horizontal" android:padding="12dp" android:layout_margin="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/btnServer" android:text="HOST" android:background="@drawable/bg_host_btn" android:textColor="#E9EDEF" android:gravity="center" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_marginEnd="6dp"/>
  <TextView android:id="@+id/btnScan" android:text="SCAN DEVICES" android:background="@drawable/bg_scan_btn" android:textColor="#E9EDEF" android:gravity="center" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="45dp" android:layout_marginStart="6dp"/>
 </LinearLayout>
 <LinearLayout android:background="@drawable/bg_top_container" android:orientation="vertical" android:padding="12dp" android:layout_marginHorizontal="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:text="Nearby Devices — tap a device to connect" android:textColor="#8696A0" android:textSize="12sp" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDevices" android:layout_width="match_parent" android:layout_height="90dp"/>
 </LinearLayout>
 <TextView android:id="@+id/tvStatus" android:text="● Offline" android:textColor="#00A884" android:textSize="11sp" android:padding="8dp" android:layout_marginStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChat" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:clipToPadding="false"/>
 <LinearLayout android:background="#202C33" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/btnAttach" android:text="📷" android:contentDescription="Choose photo" android:textSize="22sp" android:gravity="center" android:layout_width="48dp" android:layout_height="48dp"/>
  <EditText android:id="@+id/etMsg" android:hint="Type a message..." android:textColor="#E9EDEF" android:textColorHint="#8696A0" android:background="@drawable/bg_input" android:padding="14dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginHorizontal="8dp" android:inputType="textCapSentences|textMultiLine"/>
  <LinearLayout android:id="@+id/btnSend" android:contentDescription="Send message" android:background="@drawable/bg_send_circle" android:gravity="center" android:layout_width="48dp" android:layout_height="48dp"><TextView android:text="➤" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
 </LinearLayout>
</LinearLayout>